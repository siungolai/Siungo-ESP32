/**
 * secrets.h.example —— WiFi 与 NTP 凭据模板
 *
 * 用法：把本文件复制成同目录下的 secrets.h，填入真实值。
 *       secrets.h 已在仓库根 .gitignore 里，**永远不要提交上来**。
 *
 * 为什么必须要 WiFi：
 *   ESP32 内部只有 RTC 计数器，**没有带电池的时钟芯片**。
 *   断电后时间必然丢失，唯一靠谱的来源是联网用 NTP 对时。
 *   对上一次之后，RTC 会自己走字，断网也能继续显示（会慢，见 README）。
 */
#pragma once

// ------------------------------ WiFi
// 本机 2.4GHz 网络。ESP32-S3 不支持 5GHz。
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// ------------------------------ NTP
// 时区字符串（POSIX TZ 格式）。中国标准时间 = UTC+8，无夏令时：
//   CST-8     → CST 是时区名（随意取），-8 表示"本地时间比 UTC 快 8 小时"。
// 注意符号方向容易搞反：POSIX 里正号表示西经，UTC+8 要写负号。
#define TZ_INFO "CST-8"

// NTP 服务器。国内用阿里/腾讯的池，比 pool.ntp.org 快且稳。
#define NTP_SERVER_1 "ntp.aliyun.com"
#define NTP_SERVER_2 "ntp.tencent.com"
#define NTP_SERVER_3 "cn.pool.ntp.org"

// WiFi 连接超时（毫秒）。超时后不再阻塞，直接进主循环先显示"未对时"。
#define WIFI_CONNECT_TIMEOUT_MS 15000
