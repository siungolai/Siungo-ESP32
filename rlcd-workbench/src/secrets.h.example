// secrets.h.example —— 复制成 src/secrets.h 后填入真实值。
// src/secrets.h 已在 .gitignore 里，永不入库。
//
// 串口日志只用 ASCII：ESP32 的 Serial 出中文容易乱码（仓库约定）。

#pragma once

// ---- WiFi（本机配网：编译期写死，见 docs/adr/0015 与策划案 §3）----
#define WIFI_SSID "your-ssid"
// 密码留空 = 开放网络，代码里要按空串处理
#define WIFI_PASS "your-password"

// ---- 服务器监控密钥 ----
// 复用 status-oled3 的那把 X-Monitor-Key（见 docs/adr/0008）。
// 请求时作为请求头发送，头名是编译期常量，不进这里。
// 为空串 = 预部署阶段，此时省略该请求头（服务器会回 403，是「还没切过来」
// 的诚实信号，不是 bug）。
#define MONITOR_KEY ""

// ---- 待办 / 快照的数据源 ----
// 域名与路径写在 src/config.h，这里只放凭据。

// ------------------------------ 数据源与探针标签（可选）
// 不填就走 config.h 里的 example.com 占位符：屏幕能点亮，但面板二会全红。
// 用自己服务器的话，把下面几条改成你的主机名。
// RLCD_PROBE_MA12 是「出站 TCP 探针」的目标，格式 host:port；
// 不探这台机就整条注释掉，那一行会显示为「?」而不是红叉。
// #define RLCD_DATA_HOST    "www.example.com"
// #define RLCD_PROBE_WEB    "www.example.com"
// #define RLCD_PROBE_SELECT "select.example.com"
// #define RLCD_PROBE_WB     "wb.example.com"
// #define RLCD_PROBE_MA12   "your-tcp-host.example:0000"
