/**
 * secrets.h.example -- WiFi and X-Monitor-Key template
 *
 * Usage: copy this file to src/secrets.h in the same directory and fill in
 *        the real values. src/secrets.h is already covered by the
 *        repo-root .gitignore rule for src/secrets.h, so it never gets
 *        committed. Precedent: clock-oled/src/secrets.h.
 *
 * Why WiFi is required at M1: the ESP32 must poll the server over HTTPS to
 * get its status. Without WiFi there is no data at all, and the screen shows
 * the "no data yet" state instead of a wrong reading.
 *
 * Note on the X-Monitor-Key: it is EMPTY at M1a. The M1a endpoint
 * (https://www.siungo.top/api/health) is public and needs no key, so the
 * key is only used at M1b (https://www.siungo.top/status/snapshot.json).
 * See docs/adr/0008 and docs/adr/0009. If you never move to M1b, leave it
 * empty.
 */
#pragma once

// ------------------------------ WiFi
// 2.4 GHz only: the ESP32-S3 has no 5 GHz radio.
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// ------------------------------ data source
// Shared key for the M1b endpoint (empty at M1a, see above).
// The server compares it against the existing MONITOR_KEY; it is not a new
// secret and never gets printed to the serial log.
#define MONITOR_KEY ""
